{
  "manifest_version": 3,
  "name": "Instruckt",
  "version": "2.3.0",
  "description": "Visual feedback tool for AI coding agents — annotate elements directly on any page.",
  "action": {
    "default_title": "Toggle Instruckt toolbar"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-BJ2cKbT4.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/content.ts-BJ2cKbT4.js",
        "assets/content.ts-BJ2cKbT4.js.map"
      ],
      "use_dynamic_url": false
    }
  ]
}
